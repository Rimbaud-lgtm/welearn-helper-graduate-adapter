{
  "manifest_version": 3,
  "name": "WeLearn Practice Assistant",
  "version": "0.3.9.2",
  "version_name": "0.3.9-preview.3",
  "description": "Local practice queue, verified input and submission protection for course 2850.",
  "permissions": ["storage", "scripting", "alarms", "sidePanel"],
  "host_permissions": ["https://welearn.sflep.com/*", "https://centercourseware.sflep.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "WeLearn 练习", "default_icon": "icons/48.png" },
  "side_panel": { "default_path": "popup.html" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://welearn.sflep.com/*", "https://centercourseware.sflep.com/*"],
    "js": ["core.js", "legacy-adapter.js", "dom-adapter.js", "catalog-adapter.js", "content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
